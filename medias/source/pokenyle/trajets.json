 "regles_css": {
  "groupe": "chaque groupe (.vol) est posé en (0, 0) du ciel ; son transform (translate, scale, rotate, dans cet ordre CSS) s’applique autour de origine_transform ; entre deux keyframes, interpolation selon la courbe de l’animation du groupe (linear) ; un délai négatif = l’animation a déjà commencé depuis |délai| au chargement",
  "oiseau": "position et taille de l’oiseau dans son groupe ; plane = translate vertical de -0,25 rem à +0,25 rem, ease-in-out, alternate",
  "battement": "les images de l’atlas défilent par crans (steps), une boucle entière d’atlas en duree_boucle_atlas_s ; délai négatif = décalage de phase",
  "ho_oh": "animation de 150 s qui commence 8 s après l’affichage : la montée occupe 0 à 30 % (45 s), puis Ho-Oh reste hors champ jusqu’à la fin du cycle ; les plumes ne tombent que pendant les 45 s qui suivent chaque début de cycle (classe .passe posée par le JS)",
  "mouvement_reduit": "si l’utilisateur demande moins d’animations, le site masque tout le ciel (fond fixe seul)"
 },
